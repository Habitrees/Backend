# Django
DJANGO_SECRET_KEY=replace-with-a-strong-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.example.com

# PostgreSQL
POSTGRES_DB=habitree_prod
POSTGRES_USER=habitree_user
POSTGRES_PASSWORD=replace-with-a-strong-password

DB_HOST=db
DB_PORT=5432

# Frontend and Security
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com

# Authentication Cookies
AUTH_REFRESH_COOKIE_NAME=habitree_refresh
AUTH_REFRESH_COOKIE_SECURE=1
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_PATH=/api/auth/

# OTP Provider
OTP_PROVIDER_SEND_URL=https://gateway.ferzz.ir/send
OTP_PROVIDER_TOKEN=replace-with-a-new-provider-token
OTP_PROVIDER_PAYLOAD_FIELD=code

# Application
DEFAULT_PHONE_REGION=IR
TERMS_VERSION=v1