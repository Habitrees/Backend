        <mxCell id="documentation" value="&lt;div dir=&quot;rtl&quot; style=&quot;font-family:DejaVu Sans;font-size:13px;line-height:1.65;color:#243b32;text-align:right&quot;&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;thead&gt;&#xa;&lt;tr&gt;&#xa;&lt;th style=&quot;border:1px solid #bbcdc1;background:#e7f0ea;padding:6px&quot;&gt;فریم&lt;/th&gt;&#xa;&lt;th style=&quot;border:1px solid #bbcdc1;background:#e7f0ea;padding:6px&quot;&gt;مدل مرتبط&lt;/th&gt;&#xa;&lt;/tr&gt;&#xa;&lt;/thead&gt;&#xa;&lt;tbody&gt;&lt;tr&gt;&#xa;&lt;td style=&quot;border:1px solid #bbcdc1;padding:6px&quot;&gt;&lt;a href=&quot;https://www.figma.com/design/XtaN3iBwuZM6Y2f7vfJVfC/Habitree?node-id=131-60281&quot;&gt;پروفایل / دسکتاپ&lt;/a&gt;&lt;/td&gt;&#xa;&lt;td style=&quot;border:1px solid #bbcdc1;padding:6px&quot;&gt;User, OTPChallenge&lt;/td&gt;&#xa;&lt;/tr&gt;&#xa;&lt;tr&gt;&#xa;&lt;td style=&quot;border:1px solid #bbcdc1;padding:6px&quot;&gt;&lt;a href=&quot;https://www.figma.com/design/XtaN3iBwuZM6Y2f7vfJVfC/Habitree?node-id=131-60882&quot;&gt;پروفایل / حالت‌ها / دسکتاپ&lt;/a&gt;&lt;/td&gt;&#xa;&lt;td style=&quot;border:1px solid #bbcdc1;padding:6px&quot;&gt;User, OTPChallenge&lt;/td&gt;&#xa;&lt;/tr&gt;&#xa;&lt;tr&gt;&#xa;&lt;td style=&quot;border:1px solid #bbcdc1;padding:6px&quot;&gt;&lt;a href=&quot;https://www.figma.com/design/XtaN3iBwuZM6Y2f7vfJVfC/Habitree?node-id=105-78490&quot;&gt;Habitree/Groups/01 List and invites / دسکتاپ&lt;/a&gt;&lt;/td&gt;&#xa;&lt;td style=&quot;border:1px solid #bbcdc1;padding:6px&quot;&gt;HabitGroup, GroupMember و جداول گروه/دعوت/چت&lt;/td&gt;&#xa;&lt;/tr&gt;&#xa;&lt;/tbody&gt;&lt;/table&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;thead&gt;&#xa;&lt;tr&gt;&#xa;&lt;th style=&quot;border:1px solid #bbcdc1;background:#e7f0ea;padding:6px&quot;&gt;فریم&lt;/th&gt;&#xa;&lt;th style=&quot;border:1px solid #bbcdc1;background:#e7f0ea;padding:6px&quot;&gt;مدل مرتبط&lt;/th&gt;&#xa;