ays do not count as failures.&lt;/p&gt;&#xa;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;thead&gt;&#xa;&lt;tr&gt;&#xa;&lt;th style=&quot;border:1px solid #bbcdc1;background:#e7f0ea;padding:6px&quot;&gt;فیلد&lt;/th&gt;&#xa;&lt;th style=&quot;border:1px solid #bbcdc1;background:#e7f0ea;padding:6px&quot;&gt;نوع&lt;/th&gt;&#xa;&lt;th style=&quot;border:1px solid #bbcdc1;background:#e7f0ea;padding:6px&quot;&gt;قید&lt;/th&gt;&#xa;&lt;th style=&quot;border:1px solid #bbcdc1;background:#e7f0ea;padding:6px&quot;&gt;مرجع&lt;/th&gt;&#xa;&lt;/tr&gt;&#xa;&lt;/thead&gt;&#xa;&lt;tbody&gt;&lt;tr&gt;&#xa;&lt;td style=&quot;border:1px solid #bbcdc1;padding:6px&quot;&gt;id&lt;/td&gt;&#xa;&lt;td style=&quot;border:1px solid #bbcdc1;padding:6px&quot;&gt;bigint&lt;/td&gt;&#xa;&lt;td style=&quot;border:1px solid #bbcdc1;padding:6px&quot;&gt;PK, NOT NULL&lt;/td&gt;&#xa;&lt;td style=&quot;border:1px solid #bbcdc1;padding:6px&quot;&gt;—&lt;/td&gt;&#xa;&lt;/tr&gt;&#xa;&lt;tr&gt;&#xa;&lt;td style=&quot;border:1px solid #bbcdc1;padding:6px&quot;&gt;participation_id&lt;/td&gt;&#xa;&lt;td style=&quot;border:1px solid #bbcdc1;padding:6px&quot;&gt;bigint&lt;/td&gt;&#xa;&lt;td style=&quot;border:1px solid #bbcdc1;padding:6px&quot;&gt;NOT NULL&lt;/td&gt;&#xa;&lt;td style=&quot;border:1px solid #bbcdc1;padding:6px&quot;&gt;Participation.id&lt;/td&gt;&#xa;&lt;/tr&gt;&#xa;&lt;tr&gt;&#xa;&lt;td style=&quot;border:1px solid #bbcdc1;padding:6px&quot;&gt;version_id&lt;/td&gt;&#xa;&lt;td style=&quot;border:1px solid #bbcdc1;padding:6px&quot;&gt;bigint&lt;/td&gt;&#xa;&lt;td style=&quot;border:1px solid #bbcdc1;padding:6px&quot;&gt;NOT NULL&lt;/td&gt;&#xa;&lt;td style=&quot;border:1px solid #bbcdc1;padding:6px&quot;&gt;ChallengeVersion.id&lt;/td&gt;&#xa;&lt;/tr&gt;&#xa;&lt;/tbody&gt;&lt;/table&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;thead&gt;&#xa;&lt;tr&gt;&#xa;&lt;th style=&quot;border:1px solid #bbcdc1;background:#e7f0e